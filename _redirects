# Cloudflare Pages publishes the repository root, so build and development
# files would otherwise be downloadable from the live site. Pages supports
# only redirect statuses, not rewrites or a 404, so send these to the
# homepage rather than serving their contents.

/package.json       /  301
/package-lock.json  /  301
/wrangler.jsonc     /  301
/AGENTS.md          /  301
/LEGGIMI.txt        /  301
/.assetsignore      /  301
/.gitignore         /  301
/tests/*            /  301
/scripts/*          /  301

# The Watford area page was removed: it was the one location outside London.
# Cloudflare caches HTML at the edge for up to 7 days, so without a rule here
# the old URL keeps serving a page that is no longer in the repository, complete
# with outdated rates on it.
/location/watford-wd17-telehandler-and-forklift-hire  /london  301
